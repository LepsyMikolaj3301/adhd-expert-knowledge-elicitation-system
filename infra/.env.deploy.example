# Copy to infra/.env.deploy (gitignored) and fill in. Read by infra/deploy.sh. Never commit real values.

# --- Neon (Console > your project > Connect) ---
# Pooled: host has "-pooler". Paste it into the backend's DATABASE_URL on Render (not used by the script).
NEON_DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct: no "-pooler". Used from this machine for migrations and the admin/vignette bootstrap.
NEON_DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Render (each service > Settings > Deploy Hook) ---
RENDER_BACKEND_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxx?key=xxxx
RENDER_FRONTEND_DEPLOY_HOOK=https://api.render.com/deploy/srv-yyyy?key=yyyy

# Public addresses, no trailing slash. Used for the health checks after a deploy.
BACKEND_URL=https://rag-backend-xxxx.onrender.com
FRONTEND_URL=https://rag-frontend-yyyy.onrender.com

# --- First admin (infra/deploy.sh bootstrap) ---
ADMIN_EMAIL=
ADMIN_NAME=
# Vignette files to import (optional step of bootstrap); the what-ifs file is scripts/elicitation/chip_whatifs.json.
VIGNETTES_DIR=data/fixtures_chips/synthetic/silver/vignettes
