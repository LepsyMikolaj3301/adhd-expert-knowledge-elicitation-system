# Copy to infra/azure/.env on the VM (docs/azure-setup-guide.md). Never commit the real file.

# Public name of the VM: the Azure DNS label, e.g. rag-demo.westeurope.cloudapp.azure.com
DOMAIN=

# Where the images are: ghcr.io/<github-owner-in-lowercase>/<repo-name>. IMAGE_TAG is set by deploy.sh.
REGISTRY=ghcr.io/owner/repo
IMAGE_TAG=latest

# The Tailscale IP (100.x.y.z) of the PC that runs Ollama (:11434) and LanguageTool (:8010).
PC_HOST=

# Generate one: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# The models that must be pulled on the PC (`ollama pull`). Empty ENHANCE_MODEL switches enhancement off.
CLASSIFIER_MODEL=qwen3.5:9b
ENHANCE_MODEL=qwen3.5:9b

# production refuses to ingest synthetic (fixture) answers. To try the app with synthetic data set
# ENVIRONMENT=development; COOKIE_SECURE stays true because the site is served over HTTPS.
ENVIRONMENT=production
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
