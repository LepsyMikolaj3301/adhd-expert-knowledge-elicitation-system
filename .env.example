# --- Postgres (relational / app data) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# The values below are for connecting from outside Docker (e.g. running the
# backend locally). Inside compose, the dev and rag-backend services override
# the hosts/ports to the in-network service names.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Hosted Postgres (Neon): the app uses the POOLED string (host has "-pooler") as DATABASE_URL. Migrations
# must use the DIRECT string: set it here when running alembic by hand against Neon. The ?sslmode and
# &channel_binding options of Neon's strings are fine as they are. Deployment: docs/deployment.md.
# DATABASE_URL_UNPOOLED=

# --- Web application ---
# development or production. "production" switches on the synthetic-data guard at ingestion.
ENVIRONMENT=development
# HTTPS-only session cookie. Always on when ENVIRONMENT=production, so production needs HTTPS or
# logins won't stick. Set to true to turn it on in other environments served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# Big models (e.g. a 35B model that does not fit in VRAM and is partly offloaded to CPU) can take
# many minutes to load and then to answer. Leave these commented while only small models are used.
# Server: how long Ollama waits for a model to load before giving up (default 5m), and how long
# it keeps a model in memory after the last request (default 5m). Needs `docker compose up -d ollama`.
# OLLAMA_LOAD_TIMEOUT=30m
# OLLAMA_KEEP_ALIVE=30m
# Client: seconds the fixture generator (scripts/elicitation/make_fixtures.py) waits for one reply (default 600).
# OLLAMA_REQUEST_TIMEOUT=1800

# Where Ollama stores models on the host (absolute path). Leave unset to use
# the named Docker volume "ollama-data". Example for WSL: /mnt/d/ollama
# OLLAMA_DATA_PATH=

# --- MinIO (local S3 emulator) ---
MINIO_ROOT_USER=minioadmin
# Must be at least 8 characters.
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_HOST_PORT=9000
# Web console: http://localhost:9001
MINIO_CONSOLE_HOST_PORT=9001

# App-level S3 credentials. minio-init creates this user; use real AWS keys in prod.
# Leave S3_ENDPOINT_URL empty to talk to real AWS S3 instead of MinIO.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=rag-app
S3_SECRET_ACCESS_KEY=rag-app-secret
S3_REGION=us-east-1
S3_BUCKET=documents

# --- Corpus fetching (scripts/corpus/fetch_sources.py) ---
# Contact address put in the User-Agent of every download request.
CONTACT_EMAIL=

# WHO ICD-API OAuth2 client credentials (register at https://icd.who.int/icdapi,
# then "View API access key"). Never commit real values.
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
