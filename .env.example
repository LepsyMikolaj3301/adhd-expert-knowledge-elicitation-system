POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# Set automatically for the rag-backend container in compose.yml; override here
# only if connecting from outside Docker (e.g. running the backend locally).
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
OLLAMA_BASE_URL=http://localhost:11434

# Where Ollama stores models on the host (absolute path). Leave unset to use
# the named Docker volume "ollama-data". Example for WSL: /mnt/d/ollama
# OLLAMA_DATA_PATH=
