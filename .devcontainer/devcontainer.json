{
  "name": "RAG Workspace",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "runServices": ["dev", "postgres", "graphdb", "graphdb-init", "ollama"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "username": "vscode",
      "uid": "automatic",
      "gid": "automatic",
      "upgradePackages": false
    }
  },
  "postCreateCommand": "git config --global --add safe.directory /workspace",
  "forwardPorts": [8000, 5432, 7200, 11434],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "git.autofetch": true,
        "git.confirmSync": false
      }
    }
  }
}
