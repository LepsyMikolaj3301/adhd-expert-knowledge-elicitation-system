{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true
    },
    {
      "name": "Script: scrape_wikipedia",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/scrape_wikipedia.py",
      "args": ["data/raw"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Script: fetch_sources",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/corpus/fetch_sources.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Script: upload_raw_documents",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/corpus/upload_raw_documents.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Script: parse_raw_documents",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/corpus/parse_raw_documents.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Script: chunk_parsed_documents",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/corpus/chunk_parsed_documents.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
