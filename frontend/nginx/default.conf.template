# The official nginx image fills ${PORT}, ${API_UPSTREAM_URL}, ${API_HOST} and ${NGINX_LOCAL_RESOLVERS}
# in from the environment at start, and writes the result to /etc/nginx/conf.d/default.conf.
# API_UPSTREAM_URL has a scheme and no trailing slash (http://rag-backend:8000, https://x.onrender.com):
# a path on it would replace the request path. API_HOST is its host name alone.

# Behind Render's load balancer the original scheme arrives in X-Forwarded-Proto.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # Render's health check. Answered here, not by the backend: a backend outage must not make
    # Render restart the frontend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API, same origin as the page: the session cookie needs no CORS. With a variable in
    # proxy_pass, nginx looks the name up at request time (not only at start) through the resolver,
    # and passes the request URI on unchanged (/api/v1/...).
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM_URL};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # A public backend (Render) routes on the Host header and needs the name in the TLS handshake.
        proxy_set_header Host ${API_HOST};
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Room for document uploads later; nginx's default of 1m would reject them.
        client_max_body_size 25m;
    }

    # Built files have a hash in their name, so they can be cached for good.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Everything else is a page of the single-page app: the router decides what to show.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
